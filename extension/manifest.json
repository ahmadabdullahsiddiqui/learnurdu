{
  "manifest_version": 3,
  "name": "Roshni Urdu — Learn Urdu",
  "version": "1.0.0",
  "description": "Learn Urdu from English — vocabulary, phrases, the script and grammar, with flashcards and quizzes. Works offline.",
  "default_locale": "en",
  "action": {
    "default_title": "Open Roshni Urdu",
    "default_popup": "app.html",
    "default_icon": {
      "192": "icon-192.png",
      "512": "icon-512.png"
    }
  },
  "icons": {
    "192": "icon-192.png",
    "512": "icon-512.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "roshni-urdu@powerfolder.com",
      "strict_min_version": "115.0"
    }
  }
}
